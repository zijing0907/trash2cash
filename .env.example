# Copy this file to .env and change what you need. Never commit .env.
# docker compose reads .env automatically.

# ---- ml-service -------------------------------------------------------------
# Which model to serve: cnn_robust or cnn. Empty = cnn_robust if its file exists, otherwise cnn.
MODEL_KEY=
# Upload limits
MAX_UPLOAD_MB=8
MAX_IMAGE_MEGAPIXELS=60
# Give up on one prediction after this many seconds (the client gets HTTP 504)
INFERENCE_TIMEOUT_S=30
# Port on your computer that docker compose maps to the ml-service
ML_SERVICE_PORT=8001
