# Copy this file to .env and change what you need. Never commit .env.
# docker compose reads .env automatically.

# ---- web ---------------------------------------------------------------------
# Port on your computer for the app (open http://localhost:8080)
WEB_PORT=8080

# ---- api ---------------------------------------------------------------------
# Signs the login cookie. Empty = a random key at every start (everyone is logged out on restart).
# For a deployment, set a long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true when the site is served over HTTPS (the browser then sends the cookie only over HTTPS)
COOKIE_SECURE=false
POSTGRES_PASSWORD=trash2cash
# Scans (and heat maps) per minute per client IP; 0 = no limit
SCAN_RATE_PER_MIN=20

# ---- ml-service + api ------------------------------------------------------------
MAX_UPLOAD_MB=8

# ---- ml-service -------------------------------------------------------------
# Which model to serve: cnn_robust or cnn. Empty = cnn_robust if its file exists, otherwise cnn.
MODEL_KEY=
MAX_IMAGE_MEGAPIXELS=60
# Give up on one prediction after this many seconds (the client gets HTTP 504)
INFERENCE_TIMEOUT_S=30
# Port on your computer for trying the ML service directly (http://localhost:8001/docs)
ML_SERVICE_PORT=8001
